<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.jab.ms</groupId>
        <artifactId>spring-boot-streaming-example</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>openapi-specs</artifactId>
    <name>openapi-specs</name>
    <description>Shared OpenAPI specification for the streaming services</description>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources/downstream</directory>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources/downstream</directory>
                <targetPath>META-INF/resources</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>downstream/**</include>
                    <include>upstream/**</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <targetPath>META-INF/resources</targetPath>
                <includes>
                    <include>downstream/**</include>
                    <include>upstream/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>openapi-spec-jar</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>openapi</classifier>
                            <classesDirectory>${project.basedir}/src/main/resources</classesDirectory>
                            <includes>
                                <include>downstream/**</include>
                                <include>upstream/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
